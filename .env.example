DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=book_system
PORT=3000
CIRCULATION_PORT=3001

# API Gateway (จุดเข้าเดียวของระบบ) และที่อยู่ของบริการที่มันส่งต่อไป
GATEWAY_PORT=8000
BOOK_SERVICE_URL=http://localhost:3000
CIRCULATION_SERVICE_URL=http://localhost:3001
GATEWAY_TIMEOUT_MS=3000

# Cache (ไม่บังคับ): ถ้าไม่ตั้ง ระบบใช้ cache ในหน่วยความจำ ถ้าตั้ง (เช่น redis://localhost:6379) จะใช้ Redis
# และเปิด cache รายการหนังสือ เพราะสองบริการใช้ Redis ร่วมกันล้าง cache ได้
# REDIS_URL=redis://localhost:6379

# ที่อยู่ของหน้าเว็บ (ใช้กำหนด CORS ของทั้งสองบริการ)
FRONTEND_ORIGIN=http://localhost:5173

# JWT: ตั้ง JWT_SECRET เป็นข้อความสุ่มยาว ๆ ของตัวเอง (ทั้งสองบริการต้องใช้ค่าเดียวกัน) ห้ามนำค่าตัวอย่างนี้ไปใช้จริง
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m            # อายุ access token (ต่ออายุด้วย refresh token ใน cookie)
# REFRESH_TOKEN_DAYS=7
# REFRESH_GRACE_SECONDS=10
# RESET_TOKEN_MINUTES=30
# RESET_DELIVERY=console       # พิมพ์ลิงก์ลืมรหัสผ่านลง log (ยังไม่มีระบบอีเมล)
# COOKIE_SECURE=true           # ใส่ Secure ให้ cookie (เมื่อใช้ HTTPS)
# ALLOW_INSECURE_DEFAULTS=true # ข้ามการบล็อกใน production (ไม่แนะนำ)

# กติกาการยืม
# MAX_ACTIVE_LOANS=5
# FINE_PER_DAY=5

# External API (Open Library)
EXTERNAL_API_BASE_URL=https://openlibrary.org
EXTERNAL_API_TIMEOUT_MS=3000
EXTERNAL_API_RETRIES=2
EXTERNAL_API_BACKOFF_MS=300
