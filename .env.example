DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=book_system
PORT=3000
CIRCULATION_PORT=3001

# ที่อยู่ของหน้าเว็บ (ใช้กำหนด CORS ของทั้งสองบริการ)
FRONTEND_ORIGIN=http://localhost:5173

# JWT: ตั้ง JWT_SECRET เป็นข้อความสุ่มยาว ๆ ของตัวเอง (ทั้งสองบริการต้องใช้ค่าเดียวกัน) ห้ามนำค่าตัวอย่างนี้ไปใช้จริง
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# External API (Open Library)
EXTERNAL_API_BASE_URL=https://openlibrary.org
EXTERNAL_API_TIMEOUT_MS=3000
EXTERNAL_API_RETRIES=2
EXTERNAL_API_BACKOFF_MS=300
